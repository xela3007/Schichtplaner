{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "#shared/*": ["./src/shared/*"],
      "@/*": ["./src/web/*"]
    }
  },
  "include": ["src/web", "src/shared"]
}
