{
  "name": "schichtplaner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#shared/*": {
      "development": "./src/shared/*",
      "default": "./dist/shared/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=development src/api/server.ts",
    "start": "node dist/api/server.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
