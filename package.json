{
  "name": "schichtplaner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#shared/*": {
      "development": "./src/shared/*",
      "default": "./dist/shared/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=development src/api/server.ts",
    "dev:web": "vite",
    "start": "node dist/api/server.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json && vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:user": "tsx --env-file-if-exists=.env --conditions=development src/api/scripts/seed-user.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.0",
    "pino-pretty": "^13.2.0",
    "railway": "^3.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hookform/resolvers": "^7.0.3",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
