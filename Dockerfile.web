# syntax=docker/dockerfile:1
# Web image (ADR-009/014): static bundle behind nginx. nginx also forwards the
# exact API endpoints to the private api service, so the browser sees a single
# origin (refresh cookie stays first-party in Safari/Firefox).
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.base.json tsconfig.web.json vite.config.ts ./
COPY src/web ./src/web
COPY src/shared ./src/shared
RUN npx vite build

FROM nginx:1.29-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/api-proxy.conf /etc/nginx/api-proxy.conf
COPY --chmod=0755 deploy/nginx/40-config-js.sh /docker-entrypoint.d/40-config-js.sh
COPY --from=build /app/dist/web /usr/share/nginx/html
# Railway sets PORT; API_INTERNAL_URL comes from the service variables.
ENV PORT=8080 API_BASE_URL=""
