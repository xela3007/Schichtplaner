NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Neon "dev" branch — pooled for the app, unpooled (direct) for migrations
DATABASE_URL=postgresql://user:password@host-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?sslmode=require
# Signing key for access tokens — generate with: openssl rand -base64 48
JWT_SECRET=
# Frontend origin — target of the email verification link
WEB_APP_URL=http://localhost:5173
# Only "true" behind a trusted proxy (Railway); enables X-Forwarded-For
TRUST_PROXY=false
# Dev-only reference user for `npm run db:seed:user`
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
